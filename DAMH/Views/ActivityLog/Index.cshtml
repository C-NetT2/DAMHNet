@model IEnumerable<DAMH.Models.ActivityLog>
@using DAMH.Models
@{
    ViewData["Title"] = "Quản lý Thay đổi";
    Layout = "_AdminLayout";
    var currentPage = ViewBag.CurrentPage ?? 1;
    var totalPages = ViewBag.TotalPages ?? 1;
    var totalCount = ViewBag.TotalCount ?? 0;
    var userId = ViewBag.UserId as string;
    var action = ViewBag.Action as string;
    var logSection = ViewBag.Section as string;
    var startDate = ViewBag.StartDate as DateTime?;
    var endDate = ViewBag.EndDate as DateTime?;
    var users = ViewBag.Users as List<ApplicationUser> ?? new List<ApplicationUser>();
    var isSuperAdmin = ViewBag.IsSuperAdmin ?? false;
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-danger">
            <i class="bi bi-journal-text"></i> Quản Lý Thay Đổi Hệ Thống
            <span class="badge bg-secondary">@totalCount bản ghi</span>
            @if (!isSuperAdmin)
            {
                <span class="badge bg-warning text-dark">Chế độ Admin</span>
            }
        </h2>
        <div>
            <a asp-action="Export"
               asp-route-userId="@userId"
               asp-route-action="@action"
               asp-route-section="@logSection"
               asp-route-startDate="@startDate"
               asp-route-endDate="@endDate"
               class="btn btn-success">
                <i class="bi bi-download"></i> Xuất CSV
            </a>
            @if (isSuperAdmin)
            {
                <button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#clearLogsModal">
                    <i class="bi bi-trash"></i> Xóa log cũ
                </button>
            }
        </div>
    </div>

    @if (!isSuperAdmin)
    {
        <div class="alert alert-info mb-4">
            <i class="bi bi-info-circle"></i>
            <strong>Lưu ý:</strong> Bạn chỉ có thể xem lịch sử thay đổi của chính mình.
            Chỉ SuperAdmin mới có thể xem toàn bộ lịch sử của hệ thống.
        </div>
    }

    <div class="search-filter-card card mb-4">
        <div class="card-header">
            <i class="bi bi-funnel-fill"></i> Bộ Lọc
        </div>
        <div class="card-body">
            <form asp-action="Index" method="get">
                <div class="row g-3">
                    @if (isSuperAdmin && users.Any())
                    {
                        <div class="col-md-3">
                            <label class="form-label">
                                <i class="bi bi-person"></i> Người dùng
                            </label>
                            <select class="form-select" name="userId">
                                <option value="">Tất cả</option>
                                @foreach (var user in users)
                                {
                                    <option value="@user.Id" selected="@(userId == user.Id)">
                                        @user.Email
                                    </option>
                                }
                            </select>
                        </div>
                    }

                    <div class="col-md-2">
                        <label class="form-label">
                            <i class="bi bi-lightning"></i> Hành động
                        </label>
                        <select class="form-select" name="action">
                            <option value="">Tất cả</option>
                            <option value="Create" selected="@(action == "Create")">Tạo mới</option>
                            <option value="Update" selected="@(action == "Update")">Cập nhật</option>
                            <option value="Delete" selected="@(action == "Delete")">Xóa</option>
                            <option value="Upload" selected="@(action == "Upload")">Upload</option>
                            <option value="Login" selected="@(action == "Login")">Đăng nhập</option>
                            <option value="Logout" selected="@(action == "Logout")">Đăng xuất</option>
                            <option value="Register" selected="@(action == "Register")">Đăng ký</option>
                            <option value="Purchase" selected="@(action == "Purchase")">Mua hàng</option>
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">
                            <i class="bi bi-grid"></i> Phần
                        </label>
                        <select class="form-select" name="section">
                            <option value="">Tất cả</option>
                            @if (isSuperAdmin)
                            {
                                <option value="SuperAdmin" selected="@(logSection == "SuperAdmin")">
                                    <i class="bi bi-shield-fill-check"></i> SuperAdmin
                                </option>
                            }
                            <option value="Book" selected="@(logSection == "Book")">Sách</option>
                            <option value="Chapter" selected="@(logSection == "Chapter")">Chương</option>
                            <option value="ChapterMedia" selected="@(logSection == "ChapterMedia")">Media Chương</option>
                            <option value="BookCover" selected="@(logSection == "BookCover")">Ảnh bìa</option>
                            <option value="BookMedia" selected="@(logSection == "BookMedia")">Media Sách</option>
                            <option value="User" selected="@(logSection == "User")">Người dùng</option>
                            <option value="Review" selected="@(logSection == "Review")">Đánh giá</option>
                            <option value="Favorite" selected="@(logSection == "Favorite")">Yêu thích</option>
                            <option value="VIP" selected="@(logSection == "VIP")">VIP</option>
                            <option value="Profile" selected="@(logSection == "Profile")">Hồ sơ</option>
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Từ ngày</label>
                        <input type="date" name="startDate" class="form-control"
                               value="@(startDate?.ToString("yyyy-MM-dd"))">
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Đến ngày</label>
                        <input type="date" name="endDate" class="form-control"
                               value="@(endDate?.ToString("yyyy-MM-dd"))">
                    </div>

                    <div class="col-md-1 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th style="width: 15%">Thời gian</th>
                                @if (isSuperAdmin)
                                {
                                    <th style="width: 15%">Người dùng</th>
                                }
                                <th style="width: 10%">Hành động</th>
                                <th style="width: 10%">Phần</th>
                                <th style="width: 30%">Chi tiết</th>
                                <th style="width: 10%">IP</th>
                                <th style="width: 10%" class="text-end">Hành động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in Model)
                            {
                                var actionColor = log.Action switch
                                {
                                    "Create" => "success",
                                    "Update" => "warning",
                                    "Delete" => "danger",
                                    "Login" => "info",
                                    "Logout" => "secondary",
                                    "Register" => "primary",
                                    "Upload" => "info",
                                    "Purchase" => "success",
                                    _ => "secondary"
                                };

                                var actionIcon = log.Action switch
                                {
                                    "Create" => "plus-circle",
                                    "Update" => "pencil-square",
                                    "Delete" => "trash",
                                    "Login" => "box-arrow-in-right",
                                    "Logout" => "box-arrow-right",
                                    "Register" => "person-plus",
                                    "Upload" => "cloud-upload",
                                    "Purchase" => "cart-check",
                                    _ => "question-circle"
                                };

                                var sectionColor = log.Section switch
                                {
                                    "SuperAdmin" => "danger",
                                    "Book" => "primary",
                                    "Chapter" => "info",
                                    "User" => "success",
                                    "VIP" => "warning",
                                    "Review" => "secondary",
                                    _ => "info"
                                };

                                <tr>
                                    <td>
                                        <small class="text-muted">
                                            @log.Timestamp.ToString("dd/MM/yyyy")
                                            <br>@log.Timestamp.ToString("HH:mm:ss")
                                        </small>
                                    </td>
                                    @if (isSuperAdmin)
                                    {
                                        <td>
                                            <i class="bi bi-person-badge text-primary"></i>
                                            <small>@log.User.Email</small>
                                        </td>
                                    }
                                    <td>
                                        <span class="badge bg-@actionColor">
                                            <i class="bi bi-@actionIcon"></i> @log.Action
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-@sectionColor">
                                            @if (log.Section == "SuperAdmin")
                                            {
                                                <i class="bi bi-shield-fill-check"></i>
                                            }
                                            @log.Section
                                        </span>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(log.EntityName))
                                        {
                                            <div class="text-truncate" title="@log.EntityName">
                                                <strong>@log.EntityName</strong>
                                            </div>
                                        }
                                        @if (!string.IsNullOrEmpty(log.Notes))
                                        {
                                            <small class="text-muted d-block text-truncate" title="@log.Notes">
                                                @log.Notes
                                            </small>
                                        }
                                    </td>
                                    <td>
                                        <small class="text-muted">@(log.IpAddress ?? "N/A")</small>
                                    </td>
                                    <td class="text-end">
                                        <a asp-action="Details" asp-route-id="@log.ActivityLogId"
                                           class="btn btn-sm btn-info text-white" title="Chi tiết">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        @if (totalPages > 1)
        {
            <nav aria-label="Page navigation" class="mt-4">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-page="@(currentPage - 1)"
                           asp-route-userId="@userId"
                           asp-route-action="@action"
                           asp-route-section="@logSection"
                           asp-route-startDate="@startDate"
                           asp-route-endDate="@endDate">
                            <i class="bi bi-chevron-left"></i> Trước
                        </a>
                    </li>

                    @{
                        int startPage = Math.Max(1, currentPage - 2);
                        int endPage = Math.Min(totalPages, currentPage + 2);
                    }

                    @for (int i = startPage; i <= endPage; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-page="@i"
                               asp-route-userId="@userId"
                               asp-route-action="@action"
                               asp-route-section="@logSection"
                               asp-route-startDate="@startDate"
                               asp-route-endDate="@endDate">@i</a>
                        </li>
                    }

                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-page="@(currentPage + 1)"
                           asp-route-userId="@userId"
                           asp-route-action="@action"
                           asp-route-section="@logSection"
                           asp-route-startDate="@startDate"
                           asp-route-endDate="@endDate">
                            Sau <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>

            <div class="pagination-info">
                Trang @currentPage / @totalPages (Tổng @totalCount bản ghi)
            </div>
        }
    }
    else
    {
        <div class="alert alert-info text-center py-5">
            <i class="bi bi-info-circle display-1"></i>
            <h4 class="mt-3">Không tìm thấy bản ghi nào</h4>
            @if (!isSuperAdmin)
            {
                <p>Bạn chưa thực hiện thao tác nào được ghi nhận.</p>
            }
        </div>
    }
</div>

@if (isSuperAdmin)
{
    <div class="modal fade" id="clearLogsModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-action="ClearOldLogs" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-header bg-warning text-dark">
                        <h5 class="modal-title">
                            <i class="bi bi-exclamation-triangle"></i> Xóa Log Cũ
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p>Chọn số ngày để xóa các bản ghi cũ hơn:</p>
                        <div class="mb-3">
                            <label class="form-label">Số ngày</label>
                            <select class="form-select" name="days">
                                <option value="30">30 ngày</option>
                                <option value="60">60 ngày</option>
                                <option value="90" selected>90 ngày</option>
                                <option value="180">180 ngày</option>
                                <option value="365">1 năm</option>
                            </select>
                        </div>
                        <div class="alert alert-warning">
                            <i class="bi bi-info-circle"></i>
                            <strong>Lưu ý:</strong> Hành động này không thể hoàn tác!
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-warning">
                            <i class="bi bi-trash"></i> Xóa
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}