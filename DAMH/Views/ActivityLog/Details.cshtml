@model DAMH.Models.ActivityLog
@{
    ViewData["Title"] = "Chi tiết nhật ký";
    Layout = "_AdminLayout";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-info">
            <i class="bi bi-info-circle"></i> Chi Tiết Nhật Ký Hoạt Động
        </h2>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">Thông Tin Chung</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">Mã nhật ký:</dt>
                        <dd class="col-sm-9"><strong>#@Model.ActivityLogId</strong></dd>

                        <dt class="col-sm-3">Thời gian:</dt>
                        <dd class="col-sm-9">@Model.Timestamp.ToString("dd/MM/yyyy HH:mm:ss")</dd>

                        <dt class="col-sm-3">Người thực hiện:</dt>
                        <dd class="col-sm-9">
                            <i class="bi bi-person-badge text-primary"></i>
                            @Model.User.Email
                        </dd>

                        <dt class="col-sm-3">Hành động:</dt>
                        <dd class="col-sm-9">
                            @{
                                var actionColor = Model.Action switch
                                {
                                    "Create" => "success",
                                    "Update" => "warning",
                                    "Delete" => "danger",
                                    _ => "secondary"
                                };
                            }
                            <span class="badge bg-@actionColor">@Model.Action</span>
                        </dd>

                        <dt class="col-sm-3">Phần:</dt>
                        <dd class="col-sm-9">
                            <span class="badge bg-info">@Model.Section</span>
                        </dd>

                        <dt class="col-sm-3">ID đối tượng:</dt>
                        <dd class="col-sm-9">@(Model.EntityId ?? "N/A")</dd>

                        <dt class="col-sm-3">Tên đối tượng:</dt>
                        <dd class="col-sm-9">
                            <strong>@(Model.EntityName ?? "N/A")</strong>
                        </dd>

                        <dt class="col-sm-3">Địa chỉ IP:</dt>
                        <dd class="col-sm-9">@(Model.IpAddress ?? "N/A")</dd>

                        @if (!string.IsNullOrEmpty(Model.Notes))
                        {
                            <dt class="col-sm-3">Ghi chú:</dt>
                            <dd class="col-sm-9">@Model.Notes</dd>
                        }
                    </dl>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.OldValues))
            {
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-warning text-dark">
                        <h5 class="mb-0">Giá Trị Cũ</h5>
                    </div>
                    <div class="card-body">
                        <pre class="bg-light p-3 rounded">@Model.OldValues</pre>
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.NewValues))
            {
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">Giá Trị Mới</h5>
                    </div>
                    <div class="card-body">
                        <pre class="bg-light p-3 rounded">@Model.NewValues</pre>
                    </div>
                </div>
            }
        </div>
    </div>
</div>